# ==============================================================================
# J.A.R.V.I.S. CONFIGURATION ENVIRONMENT
# ==============================================================================

# AI Cognitive Engine: "gemini", "openai", or "ollama"
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Google Gemini Settings (Recommended - Free Tier Available at https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# ------------------------------------------------------------------------------
# OpenAI Settings (Optional Alternative: https://platform.openai.com/)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Local Ollama Settings (Optional - 100% Offline Local Model)
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# ------------------------------------------------------------------------------
# Assistant Persona & System Settings
# ------------------------------------------------------------------------------
JARVIS_USER_NAME=Sir
JARVIS_LANGUAGE=en
PORT=8000

# ------------------------------------------------------------------------------
# Telegram Bot Remote Uplink (Optional - Get token from @BotFather)
# Allows chatting with Jarvis, receiving code/shorts, and voice notes via mobile.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_CHAT_ID=
